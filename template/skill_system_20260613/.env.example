# LLM Settings
OPENAI_API_KEY=EMPTY
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Server Settings
HOST=0.0.0.0
PORT=8000

# Workspace Settings
WORKSPACE_ROOT=./workspace
ACTIVE_TEMPLATE=skill_system_20260613

# Feishu Settings (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BOT_NAME=MRA Bot
FEISHU_WEBHOOK_PATH=/feishu/webhook

# Skills & Plan Injection Mode
# static: load once at startup (low cost)
# dynamic: re-evaluate every LLM call (reflects latest state)
SKILLS_INJECTION_MODE=static
PLAN_INJECTION_MODE=dynamic
